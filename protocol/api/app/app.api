syntax = "v1"

import "types.api"
import "account.api"
import "common.api"
import "content.api"
import "discussion.api"
import "media.api"
import "site.api"

info (
	title:                       "Blog APP API"
	description:                 "Blog APP 接口文档 - 博客系统用户端API"
	version:                     "v1.0.0"
	contactName:                 "waynie.wei" // 技术支持联系人姓名
	contactEmail:                "791422171@qq.com" // 联系人邮箱
	contactURL:                  "https://github.com/ve-weiyi/blog-cloud" // 联系人相关链接
	termsOfService:              "https://github.com/ve-weiyi/blog-cloud" // API服务条款URL
	licenseName:                 "MIT" // 许可证类型(如 MIT/Apache 2.0/GPL等)
	licenseURL:                  "https://github.com/ve-weiyi/blog-cloud/main/LICENSE" // 许可证详情URL
	consumes:                    "application/json" // 默认请求内容类型，可配置多个用逗号分隔
	produces:                    "application/json" // 默认响应内容类型，可配置多个用逗号分隔
	schemes:                     "http,https,ws,wss" // 支持协议(http/https/ws/wss)，可配置多个
	host:                        "" // API服务主机地址(不带协议头)
	basePath:                    "" // API基础路径，所有接口都会添加此前缀
	wrapCodeMsg:                 true
	useDefinitions:              true
	bizCodeEnumDescription:      "4100-未登录<br>4200-无操作权限"
	securityDefinitionsFromJson: `
{
"AppName": {"type": "apiKey", "name": "App-Name", "in": "header", "description": "应用名称，用于标识调用方"},
"Timestamp": {"type": "apiKey", "name": "Timestamp", "in": "header", "description": "时间戳，用于校验请求是否过期"},
"XDeviceId": {"type": "apiKey", "name": "X-Device-Id", "in": "header", "description": "终端id，用于标识用户使用设备"},
"XDeviceToken": {"type": "apiKey", "name": "X-Device-Token", "in": "header", "description": "游客token，使用时间戳和终端id生成"},
"Uid": {"type": "apiKey", "name": "Uid", "in": "header", "description": "用户id，用于标识用户"},
"Authorization": {"type": "apiKey", "name": "Authorization", "in": "header", "description": "授权token，用户登录凭证"}
}`
)

type (
	PingReq  {}
	PingResp {
		Env         string `json:"env"`
		Name        string `json:"name"`
		Version     string `json:"version"`
		Runtime     string `json:"runtime"`
		Description string `json:"description"`
	}
)

@server (
	prefix: /api/v1
)
service app-api {
	@doc "健康检查"
	@handler Ping
	get /ping (PingReq) returns (PingResp)
}

