syntax = "v1"

import "types.api"

// ==================== 相册模块 ====================
type (
	Album {
		Id         int64  `json:"id"` // 主键
		AlbumName  string `json:"album_name"` // 相册名
		AlbumDesc  string `json:"album_desc"` // 相册描述
		AlbumCover string `json:"album_cover"` // 相册封面
	}
	QueryAlbumListReq {
		ListQuery
	}
	GetAlbumReq {
		AlbumId int64 `path:"id"`
	}
)

@server (
	tags:     "相册"
	prefix:   /api/v1
	group:    media/album
	authType: apiKey
)
service app-api {
	@doc "获取相册列表"
	@handler QueryAlbumList
	get /albums (QueryAlbumListReq) returns (ListResult)

	@doc "获取相册详情"
	@handler GetAlbum
	get /albums/:id (GetAlbumReq) returns (Album)
}

// ==================== 照片模块 ====================
type (
	Photo {
		Id       int64  `json:"id"` // 主键
		PhotoUrl string `json:"photo_url"` // 照片地址
	}
	QueryAlbumPhotoListReq {
		AlbumId int64 `path:"album_id"` // 相册ID
	}
)

@server (
	tags:     "照片"
	prefix:   /api/v1
	group:    media/photo
	authType: apiKey
)
service app-api {
	@doc "获取相册下的照片列表"
	@handler QueryAlbumPhotoList
	get /albums/:album_id/photos (QueryAlbumPhotoListReq) returns (ListResult)
}

