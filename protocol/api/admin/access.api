syntax = "v1"

import "types.api"

// ============================================
// 接口管理
// ============================================
type (
	ApiVO {
		Id        int64    `json:"id,optional"` // 主键id
		ParentId  int64    `json:"parent_id"` // 分组id
		Name      string   `json:"name"` // api名称
		Path      string   `json:"path"` // api路径
		Method    string   `json:"method"` // api请求方法
		Traceable int64    `json:"traceable"` // 是否追溯操作记录 0不需要，1需要
		Status    int64    `json:"status"` // 状态 0正常 1禁用
		CreatedAt int64    `json:"created_at"` // 创建时间
		UpdatedAt int64    `json:"updated_at"` // 更新时间
		Children  []*ApiVO `json:"children,optional"`
	}
	CreateApiReq {
		ParentId  int64  `json:"parent_id"` // 分组id
		Name      string `json:"name"` // api名称
		Path      string `json:"path"` // api路径
		Method    string `json:"method"` // api请求方法
		Traceable int64  `json:"traceable"` // 是否追溯操作记录 0不需要，1需要
		Status    int64  `json:"status"` // 状态 0正常 1禁用
	}
	GetApiReq {
		Id int64 `path:"id"` // 主键id
	}
	UpdateApiReq {
		Id        int64  `path:"id"` // 主键id
		ParentId  int64  `json:"parent_id"` // 分组id
		Name      string `json:"name"` // api名称
		Path      string `json:"path"` // api路径
		Method    string `json:"method"` // api请求方法
		Traceable int64  `json:"traceable"` // 是否追溯操作记录 0不需要，1需要
		Status    int64  `json:"status"` // 状态 0正常 1禁用
	}
	DeleteApiReq {
		Ids []int64 `json:"ids"` // 主键id
	}
	QueryApiListReq {
		ListQuery
		Name   *string `json:"name,optional"` // api名称
		Path   *string `json:"path,optional"` // api路径
		Method *string `json:"method,optional"` // api请求方法
		Status *int64  `json:"status,optional"` // 状态
	}
	SyncApiResp {
		SuccessCount int64 `json:"success_count"` // 同步成功数量
	}
	CleanApiResp {
		SuccessCount int64 `json:"success_count"` // 清空成功数量
	}
)

@server (
	tags:       "接口管理"
	prefix:     /admin-api/v1
	group:      access/api
	authType:   apiKey
	middleware: AdminAuth,Permission,OperationLog
)
service admin-api {
	@doc "获取接口列表"
	@handler QueryApiList
	get /apis (QueryApiListReq) returns (ListResult)

	@doc "创建接口"
	@handler CreateApi
	post /apis (CreateApiReq) returns (ApiVO)

	@doc "获取接口详情"
	@handler GetApi
	get /apis/:id (GetApiReq) returns (ApiVO)

	@doc "更新接口"
	@handler UpdateApi
	put /apis/:id (UpdateApiReq) returns (ApiVO)

	@doc "批量删除接口"
	@handler BatchDeleteApi
	post /apis/batch-delete (DeleteApiReq) returns (BatchResp)

	@doc "同步接口列表"
	@handler SyncApi
	post /apis/sync (EmptyReq) returns (SyncApiResp)

	@doc "清空接口列表"
	@handler CleanApi
	post /apis/clean (EmptyReq) returns (CleanApiResp)
}

// ============================================
// 菜单管理
// ============================================
type (
	MenuMeta {
		Type       string            `json:"type"` // 菜单类型（CATALOG目录、MENU菜单、BUTTON按钮）
		Title      string            `json:"title,optional"` // 菜单标题
		Icon       string            `json:"icon,optional"` // 菜单图标
		Rank       int64             `json:"rank,optional"` // 排序
		Perm       string            `json:"perm,optional"` // 权限标识
		Params     []*MenuMetaParams `json:"params,optional"` // 参数
		KeepAlive  int64             `json:"keep_alive,optional"` // 是否缓存
		AlwaysShow int64             `json:"always_show,optional"` // 是否一直显示菜单
		Visible    int64             `json:"visible,optional"` // 菜单是否可见
		Status     int64             `json:"status"` // 状态 0正常 1禁用
	}
	MenuMetaParams {
		Key   string `json:"key"`
		Value string `json:"value"`
	}
	MenuVO {
		Id        int64  `json:"id,optional"` // 主键
		ParentId  int64  `json:"parent_id"` // 父id
		Path      string `json:"path"` // 路由地址
		Name      string `json:"name"` // 路由名字
		Component string `json:"component"` // Layout组件
		Redirect  string `json:"redirect,optional"` // 路由重定向
		MenuMeta
		CreatedAt int64     `json:"created_at"` // 创建时间
		UpdatedAt int64     `json:"updated_at"` // 更新时间
		Children  []*MenuVO `json:"children,optional"`
	}
	CreateMenuReq {
		ParentId  int64            `json:"parent_id"` // 父id
		Path      string           `json:"path"` // 路由地址
		Name      string           `json:"name"` // 路由名字
		Component string           `json:"component"` // Layout组件
		Redirect  string           `json:"redirect,optional"` // 路由重定向
		Children  []*CreateMenuReq `json:"children,optional"`
		MenuMeta
	}
	GetMenuReq {
		Id int64 `path:"id"` // 主键
	}
	UpdateMenuReq {
		Id        int64  `path:"id"` // 主键
		ParentId  int64  `json:"parent_id"` // 父id
		Path      string `json:"path"` // 路由地址
		Name      string `json:"name"` // 路由名字
		Component string `json:"component"` // Layout组件
		Redirect  string `json:"redirect,optional"` // 路由重定向
		MenuMeta
	}
	DeleteMenuReq {
		Ids []int64 `json:"ids"` // 主键id
	}
	SyncMenuReq {
		Menus []*CreateMenuReq `json:"menus"`
	}
	QueryMenuListReq {
		ListQuery
		Name   *string `json:"name,optional"` // 路由名字
		Title  *string `json:"title,optional"` // 菜单标题
		Status *int64  `json:"status,optional"` // 状态
	}
	SyncMenuResp {
		SuccessCount int64 `json:"success_count"` // 同步成功数量
	}
	CleanMenuReq  {}
	CleanMenuResp {
		SuccessCount int64 `json:"success_count"` // 清空成功数量
	}
)

@server (
	tags:       "菜单管理"
	prefix:     /admin-api/v1
	group:      access/menu
	authType:   apiKey
	middleware: AdminAuth,Permission,OperationLog
)
service admin-api {
	@doc "获取菜单列表"
	@handler QueryMenuList
	get /menus (QueryMenuListReq) returns (ListResult)

	@doc "创建菜单"
	@handler CreateMenu
	post /menus (CreateMenuReq) returns (MenuVO)

	@doc "获取菜单详情"
	@handler GetMenu
	get /menus/:id (GetMenuReq) returns (MenuVO)

	@doc "更新菜单"
	@handler UpdateMenu
	put /menus/:id (UpdateMenuReq) returns (MenuVO)

	@doc "批量删除菜单"
	@handler BatchDeleteMenu
	post /menus/batch-delete (DeleteMenuReq) returns (BatchResp)

	@doc "同步菜单列表"
	@handler SyncMenu
	post /menus/sync (SyncMenuReq) returns (SyncMenuResp)

	@doc "清空菜单列表"
	@handler CleanMenu
	post /menus/clean (CleanMenuReq) returns (CleanMenuResp)
}

// ============================================
// 角色管理
// ============================================
type (
	// 角色信息VO - 后端返回视图对象
	RoleVO {
		Id          int64  `json:"id,optional"` // 主键ID
		ParentId    int64  `json:"parent_id"` // 父角色ID
		RoleKey     string `json:"role_key"` // 角色标识（唯一）
		RoleLabel   string `json:"role_label"` // 角色名称（展示用）
		RoleComment string `json:"role_comment"` // 角色备注说明
		IsDefault   int64  `json:"is_default"` // 是否默认角色 0-否 1-是
		Status      int64  `json:"status"` // 状态 0-正常 1-禁用
		CreatedAt   int64  `json:"created_at"` // 创建时间（时间戳）
		UpdatedAt   int64  `json:"updated_at"` // 更新时间（时间戳）
	}
	// 角色创建请求
	CreateRoleReq {
		ParentId    int64  `json:"parent_id,optional"` // 父角色ID（可选，默认顶级角色）
		RoleKey     string `json:"role_key"` // 角色标识（必填，唯一）
		RoleLabel   string `json:"role_label"` // 角色名称（必填）
		RoleComment string `json:"role_comment"` // 角色备注（必填）
		IsDefault   int64  `json:"is_default"` // 是否默认角色 0-否 1-是（必填）
		Status      int64  `json:"status"` // 状态 0-正常 1-禁用（必填）
	}
	// 获取角色详情请求
	GetRoleReq {
		Id int64 `path:"id"` // 角色ID
	}
	// 角色更新请求
	UpdateRoleReq {
		Id          int64  `path:"id"` // 主键ID（必填）
		ParentId    int64  `json:"parent_id,optional"` // 父角色ID（可选）
		RoleKey     string `json:"role_key"` // 角色标识（必填，唯一）
		RoleLabel   string `json:"role_label"` // 角色名称（必填）
		RoleComment string `json:"role_comment"` // 角色备注（必填）
		IsDefault   int64  `json:"is_default"` // 是否默认角色 0-否 1-是（必填）
		Status      int64  `json:"status"` // 状态 0-正常 1-禁用（必填）
	}
	// 删除角色请求
	DeleteRoleReq {
		Ids []int64 `json:"ids"` // 角色ID列表
	}
	// 获取角色权限请求
	GetRolePermissionsReq {
		RoleId int64 `path:"role_id"` // 角色ID
	}
	// 角色资源权限响应
	RolePermissionsResp {
		RoleId  int64   `json:"role_id"` // 角色ID
		ApiIds  []int64 `json:"api_ids"` // 绑定的接口权限ID列表
		MenuIds []int64 `json:"menu_ids"` // 绑定的菜单权限ID列表
	}
	// 更新角色接口权限请求
	UpdateRoleApiPermissionsReq {
		RoleId int64   `path:"role_id"` // 角色ID（必填）
		ApiIds []int64 `json:"api_ids"` // 接口权限ID列表（必填，空数组表示清空权限）
	}
	// 更新角色菜单权限请求
	UpdateRoleMenuPermissionsReq {
		RoleId  int64   `path:"role_id"` // 角色ID（必填）
		MenuIds []int64 `json:"menu_ids"` // 菜单权限ID列表（必填，空数组表示清空权限）
	}
	// 角色列表查询请求
	QueryRoleListReq {
		ListQuery // 继承分页查询基础结构体（包含page、page_size等）
		RoleKey   *string `json:"role_key,optional"` // 角色标识（模糊查询）
		RoleLabel *string `json:"role_label,optional"` // 角色名称（模糊查询）
		Status    *int64  `json:"status,optional"` // 状态 0-正常 1-禁用（精确查询）
	}
)

@server (
	tags:       "角色管理"
	prefix:     /admin-api/v1
	group:      access/role
	authType:   apiKey
	middleware: AdminAuth,Permission,OperationLog
)
service admin-api {
	@doc "获取角色列表"
	@handler QueryRoleList
	get /roles (QueryRoleListReq) returns (ListResult)

	@doc "获取角色详情"
	@handler GetRole
	get /roles/:id (GetRoleReq) returns (RoleVO)

	@doc "创建角色"
	@handler CreateRole
	post /roles (CreateRoleReq) returns (RoleVO)

	@doc "更新角色信息"
	@handler UpdateRole
	put /roles/:id (UpdateRoleReq) returns (RoleVO)

	@doc "批量删除角色"
	@handler BatchDeleteRole
	post /roles/batch-delete (DeleteRoleReq) returns (BatchResp)

	@doc "查询角色权限配置"
	@handler GetRolePermissions
	get /roles/:role_id/permissions (GetRolePermissionsReq) returns (RolePermissionsResp)

	@doc "更新角色菜单权限"
	@handler UpdateRoleMenuPermissions
	put /roles/:role_id/menus (UpdateRoleMenuPermissionsReq) returns (EmptyResp)

	@doc "更新角色接口权限"
	@handler UpdateRoleApiPermissions
	put /roles/:role_id/apis (UpdateRoleApiPermissionsReq) returns (EmptyResp)
}

