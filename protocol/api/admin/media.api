syntax = "v1"

import "types.api"

// ==================== 相册管理 ====================
type (
	AlbumVO {
		Id         int64  `json:"id,optional"`
		AlbumName  string `json:"album_name"`
		AlbumDesc  string `json:"album_desc"`
		AlbumCover string `json:"album_cover"`
		IsDelete   int64  `json:"is_delete"`
		Status     int64  `json:"status"`
		CreatedAt  int64  `json:"created_at"`
		UpdatedAt  int64  `json:"updated_at"`
		PhotoCount int64  `json:"photo_count"`
	}
	CreateAlbumReq {
		AlbumName  string `json:"album_name"`
		AlbumDesc  string `json:"album_desc"`
		AlbumCover string `json:"album_cover"`
		Status     int64  `json:"status"`
	}
	UpdateAlbumReq {
		Id         int64  `path:"id"`
		AlbumName  string `json:"album_name"`
		AlbumDesc  string `json:"album_desc"`
		AlbumCover string `json:"album_cover"`
		Status     int64  `json:"status"`
	}
	QueryAlbumListReq {
		ListQuery
		AlbumName *string `json:"album_name,optional"`
		IsDelete  *int64  `json:"is_delete,optional"`
	}
	GetAlbumReq {
		Id int64 `path:"id"`
	}
	DeleteAlbumReq {
		Ids []int64 `json:"ids"`
	}
	RestoreAlbumReq {
		Ids []int64 `json:"ids"`
	}
	DestroyAlbumReq {
		Ids []int64 `json:"ids"`
	}
)

@server (
	tags:       "相册管理"
	prefix:     /admin-api/v1
	group:      media/album
	authType:   apiKey
	middleware: AdminAuth,Permission,OperationLog
)
service admin-api {
	@doc "获取相册列表"
	@handler QueryAlbumList
	get /albums (QueryAlbumListReq) returns (ListResult)

	@doc "获取相册详情"
	@handler GetAlbum
	get /albums/:id (GetAlbumReq) returns (AlbumVO)

	@doc "创建相册"
	@handler CreateAlbum
	post /albums (CreateAlbumReq) returns (AlbumVO)

	@doc "更新相册"
	@handler UpdateAlbum
	put /albums/:id (UpdateAlbumReq) returns (AlbumVO)

	@doc "批量删除相册（移入回收站）"
	@handler BatchDeleteAlbum
	post /albums/batch-delete (DeleteAlbumReq) returns (BatchResp)

	@doc "批量恢复相册"
	@handler BatchRestoreAlbum
	post /albums/batch-restore (RestoreAlbumReq) returns (BatchResp)

	@doc "批量销毁相册（彻底删除，不可恢复）"
	@handler BatchDestroyAlbum
	post /albums/batch-destroy (DestroyAlbumReq) returns (BatchResp)
}

// ==================== 照片管理 ====================
type (
	PhotoVO {
		Id        int64  `json:"id,optional"`
		AlbumId   int64  `json:"album_id"`
		PhotoName string `json:"photo_name"`
		PhotoDesc string `json:"photo_desc"`
		PhotoSrc  string `json:"photo_src"`
		IsDelete  int64  `json:"is_delete"`
		CreatedAt int64  `json:"created_at"`
		UpdatedAt int64  `json:"updated_at"`
	}
	CreatePhotoReq {
		AlbumId   int64  `json:"album_id"`
		PhotoName string `json:"photo_name"`
		PhotoDesc string `json:"photo_desc"`
		PhotoSrc  string `json:"photo_src"`
	}
	UpdatePhotoReq {
		Id        int64  `path:"id"`
		AlbumId   int64  `json:"album_id"`
		PhotoName string `json:"photo_name"`
		PhotoDesc string `json:"photo_desc"`
		PhotoSrc  string `json:"photo_src"`
	}
	QueryPhotoListReq {
		ListQuery
		AlbumId  *int64 `json:"album_id,optional"`
		IsDelete *int64 `json:"is_delete,optional"`
	}
	DeletePhotoReq {
		Ids []int64 `json:"ids"`
	}
	RestorePhotoReq {
		Ids []int64 `json:"ids"`
	}
	DestroyPhotoReq {
		Ids []int64 `json:"ids"`
	}
)

@server (
	tags:       "照片管理"
	prefix:     /admin-api/v1
	group:      media/photo
	authType:   apiKey
	middleware: AdminAuth,Permission,OperationLog
)
service admin-api {
	@doc "获取照片列表"
	@handler QueryPhotoList
	get /photos (QueryPhotoListReq) returns (ListResult)

	@doc "创建照片"
	@handler CreatePhoto
	post /photos (CreatePhotoReq) returns (PhotoVO)

	@doc "更新照片"
	@handler UpdatePhoto
	put /photos/:id (UpdatePhotoReq) returns (PhotoVO)

	@doc "批量删除照片（移入回收站）"
	@handler BatchDeletePhoto
	post /photos/batch-delete (DeletePhotoReq) returns (BatchResp)

	@doc "批量恢复照片"
	@handler BatchRestorePhoto
	post /photos/batch-restore (RestorePhotoReq) returns (BatchResp)

	@doc "批量销毁照片（彻底删除，不可恢复）"
	@handler BatchDestroyPhoto
	post /photos/batch-destroy (DestroyPhotoReq) returns (BatchResp)
}

