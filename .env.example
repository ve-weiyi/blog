# blog monorepo 环境变量模板
#
# 复制后使用：
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# `.env` 已被 gitignore；本文件只放占位值，不要填入真实凭据后提交。
#
# 本文件收录 Go 代码、测试与诊断程序通过 os.Getenv / os.LookupEnv 读取的变量。
# 部署形态的变量不在这里重复：见 deploy/docker/.env.example。
# 前端 Vite 变量见 blog-app/.env* 与 blog-admin/.env*。

# ─────────────────────────────────────────────
# 测试：需要真实服务的用例
# 未设置时对应测试自动 t.Skip
# ─────────────────────────────────────────────

# MySQL DSN，供 goctlx/parserx/sqlspec 解析真实库表结构
# 格式：user:password@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=True&loc=Local
TEST_MYSQL_DSN=

# 外部 xlsx 文件路径，供 vkit/x/excelx 的导入测试
EXCELX_TEST_FILE=

# 七牛 Kodo 真实上传测试。三个必填项缺一即跳过；上传会写入真实 bucket。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 以下为可选项
QINIU_CDN_DOMAIN=
QINIU_ENDPOINT=https://up-z2.qiniup.com
QINIU_REGION=huanan

# ─────────────────────────────────────────────
# 诊断程序：vkit/cmd/*
# 需要真实凭证，执行前务必确认不会误发/误传
# ─────────────────────────────────────────────

# vkit/cmd/mailtest：SMTP 授权码（邮箱、端口等通过命令行参数指定）
MAIL_PASSWORD=

# vkit/cmd/smstest：短信服务凭证
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# vkit/cmd/gormgen 复用上面的 TEST_MYSQL_DSN
# vkit/cmd/storagetest 复用上面的 QINIU_ACCESS_KEY / QINIU_SECRET_KEY

# ─────────────────────────────────────────────
# Redis 诊断/运维工具预留
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD 必须显式设置；
# 无鉴权实例也要把 REDIS_PASSWORD 设为空串，不能省略。
# ─────────────────────────────────────────────

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 可选，默认 0
REDIS_DB=0

# ─────────────────────────────────────────────
# 部署与前端
# ─────────────────────────────────────────────
# Docker 部署变量（IMAGE_TAG、NACOS_*）请使用 deploy/docker/.env.example，
# 避免与部署脚本的真相源产生第二份副本。
# 前端 VITE_* 变量由各前端目录的 .env/.env.* 文件提供，不在此文件维护。
